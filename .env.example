# Producer Studio server configuration (apps/server). Every variable is optional in development.

# ---- process ----
PORT=8787                     # HTTP port
HOST=0.0.0.0                  # bind address
ROLE=all                      # all = API + worker in one process | api | worker
MODE=cloud                    # cloud (hosted, multi-user) | desktop (Electron, one local user)
NODE_ENV=development          # production => Secure cookies, SPA served from apps/web/dist
PUBLIC_URL=                   # e.g. https://studio.example.com — prefixes invite/share URLs (else relative)
LOG_LEVEL=info                # debug | info | warn | error (JSON lines on stdout/stderr)
LOG_PRETTY=0                  # 1 = human-readable log lines
LOG_SILENT=0                  # 1 = no logs (tests)

# ---- database ----
DATABASE_URL=                 # postgres://user:pass@host:5432/db — unset => embedded PGlite
DATA_DIR=                     # default apps/server/.data (PGlite, local storage, renders, temp files)
PGLITE_DIR=                   # default $DATA_DIR/pg ('memory://' for an in-memory database)

# ---- object storage (unset S3_BUCKET => local disk under $DATA_DIR/storage) ----
S3_BUCKET=
S3_ENDPOINT=                  # e.g. https://<account>.r2.cloudflarestorage.com (bucket needs CORS for browser PUT/GET)
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false     # true for MinIO / Railway buckets
MAX_UPLOAD_MB=4096            # per-file upload limit

# ---- jobs ----
WORKER_CONCURRENCY=2          # parallel jobs per worker process
KEEP_RENDERS=0                # 1 = keep .data/renders/<jobId>/ after export (debugging)

# ---- media tools ----
FFMPEG_PATH=                  # default: ffmpeg-static binary (Docker: /usr/bin/ffmpeg)
FFPROBE_PATH=                 # default: ffprobe-static binary (Docker: /usr/bin/ffprobe)
WHISPER_CLI=                  # whisper.cpp CLI; dev default: the copy bundled with the Producer desktop app
WHISPER_MODEL=                # ggml model; dev default: Producer's ggml-small.en.bin (Docker: /opt/whisper/ggml-small.en.bin)
WHISPER_THREADS=              # default: cores - 1 (2..8)
KOKORO_CACHE=                 # dir containing onnx-community/Kokoro-82M-v1.0-ONNX (downloaded here if missing)
CHROME_PATH=                  # chrome-headless-shell for HyperFrames (auto-managed; set only if it can't find one)
HF_USE_CACHED_CHROME=0        # 1 = pass the chrome-headless-shell found under ~/.cache/hyperframes as CHROME_PATH
HYPERFRAMES_PROTOCOL_TIMEOUT= # ms, for long renders on slow machines (passed as --protocol-timeout)
NODE_OPTIONS=                 # Windows behind TLS inspection: --use-system-ca (added automatically for renders)

# ---- AI ----
AI_PROVIDER=                  # anthropic-api (cloud default) | claude-cli (desktop default) | none
ANTHROPIC_API_KEY=            # Claude API key (or ANTHROPIC_AUTH_TOKEN / ANTHROPIC_PROFILE / an `ant auth login` profile)
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_PROFILE=
ANTHROPIC_CONFIG_DIR=         # where `ant` profiles live (default ~/.config/anthropic)
PRODUCER_SKILL_DIR=           # producer-pipeline skill (looks + house rules); default ~/.claude/skills/producer-pipeline, else apps/server/skill

# ---- web ----
WEB_DIST=                     # built SPA to serve (default apps/web/dist)
